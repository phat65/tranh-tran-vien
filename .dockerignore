.git
.gitignore
.vscode

**/node_modules
**/.next
**/.medusa
**/.turbo
**/coverage
**/*.log

# Never send local or production secrets to the Docker build context.
**/.env
**/.env.local
**/.env.development.local
**/.env.production.local
deploy/env/backend.env
deploy/env/storefront.env

# Runtime-generated uploads and temporary files.
apps/backend/static
apps/storefront/public/custom-wall-uploads
**/tmp
**/temp

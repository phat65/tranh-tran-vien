NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tranh_tran_vien
REDIS_URL=redis://localhost:6379
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:8000
JWT_SECRET=change-me
COOKIE_SECRET=change-me

# Cloudflare R2 / S3-compatible storage used by Medusa admin uploads.
# Example endpoint: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=<bucket-name>
S3_ACCESS_KEY_ID=<r2-access-key-id>
S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
S3_FILE_URL=https://<public-r2-domain-or-custom-domain>
S3_PUBLIC_BASE_URL=https://<public-r2-domain-or-custom-domain>
S3_PREFIX=catalog
S3_CACHE_CONTROL=public, max-age=31536000
S3_DOWNLOAD_FILE_DURATION=3600
S3_FORCE_PATH_STYLE=true

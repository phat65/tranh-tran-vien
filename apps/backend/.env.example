STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6380
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/tranh_tran_vien
DB_NAME=tranh_tran_vien
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_ADMIN_MAX_UPLOAD_FILE_SIZE=52428800

NODE_ENV=development
PAYOS_RETURN_URL=http://localhost:8000/vn/checkout/payos/return
PAYOS_CANCEL_URL=http://localhost:8000/vn/checkout/payos/return

# SePay Payment Gateway
# Leave credentials empty to keep SePay disabled.
SEPAY_ENVIRONMENT=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_SUCCESS_URL=http://localhost:8000/vn/checkout/sepay/return?result=success
SEPAY_ERROR_URL=http://localhost:8000/vn/checkout/sepay/return?result=error
SEPAY_CANCEL_URL=http://localhost:8000/vn/checkout/sepay/return?result=cancel
SEPAY_PAYMENT_METHOD=BANK_TRANSFER
SEPAY_IPN_SECRET=


# Cloudflare R2 / S3-compatible storage
# Leave these empty to use local file storage in development.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FILE_URL=
S3_PUBLIC_BASE_URL=

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=


{
  "name": "tranh-tran-vien",
  "private": false,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "backend:db:generate": "pnpm -C apps/backend db:generate",
    "backend:db:migrate": "pnpm -C apps/backend db:migrate",
    "backend:db:sync-links": "pnpm -C apps/backend db:sync-links",
    "backend:seed": "pnpm -C apps/backend seed",
    "backend:seed:catalog:hexagon": "pnpm -C apps/backend seed:catalog:hexagon",
    "backend:seed:hexagon": "pnpm run backend:seed:catalog:hexagon",
    "backend:store:rename-vietnam": "pnpm -C apps/backend store:rename-vietnam",
    "backend:images:bulk-upload": "pnpm -C apps/backend images:bulk-upload",
    "backend:payos:setup": "pnpm -C apps/backend payos:setup",
    "backend:sepay:setup": "pnpm -C apps/backend sepay:setup",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.16.0",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  }
}

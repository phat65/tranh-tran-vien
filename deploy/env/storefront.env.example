# Production storefront environment for Docker Compose.
# Copy this file to storefront.env and replace example.com / placeholder values.
# NEXT_PUBLIC_* values are embedded during `next build`, so rebuild the image
# whenever one of these values changes.

NODE_ENV=production

# Public storefront and Medusa URLs
NEXT_PUBLIC_BASE_URL=https://example.com
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.example.com
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_CHANGE_ME_VN_SHOP_KEY
NEXT_PUBLIC_DEFAULT_REGION=vn

# Must match S3_FILE_URL / S3_PUBLIC_BASE_URL in backend.env.
NEXT_PUBLIC_STORAGE_PUBLIC_URL=https://media.example.com

# Optional card-payment configuration. Leave empty when Stripe/Medusa Payments
# is not configured; PayOS and SePay secrets must never be placed here.
NEXT_PUBLIC_STRIPE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_ACCOUNT_ID=

# Optional Medusa Cloud image pattern. Leave empty when using Cloudflare R2.
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=

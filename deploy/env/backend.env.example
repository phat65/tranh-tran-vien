# Production backend environment for Docker Compose.
# Copy this file to backend.env and replace every CHANGE_ME / example.com value.
# Never commit backend.env because it contains database and payment secrets.

# Runtime
NODE_ENV=production
MEDUSA_BACKEND_URL=https://api.example.com
MEDUSA_ADMIN_MAX_UPLOAD_FILE_SIZE=52428800

# PostgreSQL container and Medusa connection
POSTGRES_DB=tranh_tran_vien
POSTGRES_USER=medusa
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql://medusa:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/tranh_tran_vien

# Redis container
REDIS_URL=redis://redis:6379

# Allowed browser origins. Do not add paths or trailing slashes.
STORE_CORS=https://example.com,https://www.example.com
ADMIN_CORS=https://api.example.com
AUTH_CORS=https://example.com,https://www.example.com,https://api.example.com

# Generate independent long random values for production.
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
COOKIE_SECRET=CHANGE_ME_LONG_RANDOM_COOKIE_SECRET

# Cloudflare R2 / S3-compatible storage
S3_ENDPOINT=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=CHANGE_ME_BUCKET_NAME
S3_ACCESS_KEY_ID=CHANGE_ME_R2_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=CHANGE_ME_R2_SECRET_ACCESS_KEY
S3_FILE_URL=https://media.example.com
S3_PUBLIC_BASE_URL=https://media.example.com
S3_PREFIX=
S3_CACHE_CONTROL=
S3_DOWNLOAD_FILE_DURATION=
S3_FORCE_PATH_STYLE=true

# PayOS. Leave every credential empty to keep PayOS disabled.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=https://example.com/vn/checkout/payos/return
PAYOS_CANCEL_URL=https://example.com/vn/checkout/payos/return
PAYOS_WEBHOOK_URL=https://api.example.com/hooks/payment/payos_payos
PAYOS_API_URL=
PAYOS_PARTNER_CODE=

# SePay inline QR. Leave every required value empty to keep SePay disabled.
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_HOLDER=
SEPAY_STORE_NAME=
SEPAY_WEBHOOK_SECRET=
